rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Verifica se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: Verifica se o documento de perfil do usuário existe
    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    // Helper: Recupera o perfil do usuário logado de forma segura
    function getUserRole() {
      return hasUserDoc() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : 'PLAYER';
    }
    
    // Helper: Verifica se o usuário é CREATOR
    function isCreator() {
      return isAuthenticated() && getUserRole() == 'CREATOR';
    }

    // Helper: Verifica se o usuário é ADMIN ou CREATOR
    function isCreatorOrAdmin() {
      return isAuthenticated() && (getUserRole() == 'CREATOR' || getUserRole() == 'ADMIN');
    }
    
    // Helper: Verifica se o usuário é ADMIN
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'ADMIN';
    }

    // Coleção de Marcadores de Granadas
    match /markers/{markerId} {
      allow read: if true;
      allow create, update, delete: if isCreatorOrAdmin();
    }
    
    // Coleção de Combos / Executes
    match /combos/{comboId} {
      allow read: if true;
      allow create, update, delete: if isCreatorOrAdmin();
    }

    // Coleção de Estratégias do Tactical Board
    match /strats/{stratId} {
      allow read: if true;
      
      // Criação:
      // - ADMIN pode criar qualquer tática
      // - CREATOR pode criar táticas públicas ou privadas vinculadas ao seu UID
      // - PLAYER (cliente normal) pode criar táticas vinculadas ao seu UID apenas como privadas (isPublic == false)
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isCreator() && request.resource.data.authorId == request.auth.uid) ||
        (request.resource.data.authorId == request.auth.uid && request.resource.data.isPublic == false)
      );
      
      // Edição:
      // - ADMIN pode editar qualquer tática
      // - CREATOR só pode editar as táticas dele próprio
      // - PLAYER só pode editar as táticas dele próprio mantendo como privada
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isCreator() && resource.data.authorId == request.auth.uid && request.resource.data.authorId == request.auth.uid) ||
        (resource.data.authorId == request.auth.uid && request.resource.data.authorId == request.auth.uid && request.resource.data.isPublic == false)
      );
      
      // Exclusão:
      // - ADMIN pode excluir qualquer tática
      // - O próprio autor pode excluir suas próprias táticas
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.authorId == request.auth.uid
      );
    }

    // Coleção de Usuários
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
